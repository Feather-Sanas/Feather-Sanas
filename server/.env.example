# Sanas Remote SDK credentials — get these from https://developer.sanas.ai
# Copy to ".env" and fill in. NEVER commit the real .env.
SANAS_ENDPOINT=sip.sanas.ai

# Auth: SANAS_API_KEY (developer-console key, e.g. sk_...) is preferred and takes
# precedence. Account-based auth is the fallback if the API key is unset.
SANAS_API_KEY=
# SANAS_ACCOUNT_ID=your_account_id
# SANAS_ACCOUNT_SECRET=your_account_secret

# Model to run on uploaded clips (Speech Enhancement by default).
# Options: SE2.2 | SE2.1 | VI_G_NC3.0 | AGENTIC_VI_G_NC | AGENTIC_ST_NC | AGENTIC_VI_GT_NC
SANAS_MODEL=SE2.2

# Frame size in ms for ProcessSamples (the SDK example uses 20ms).
SANAS_FRAME_MS=20
# Silent frames fed after input to flush the pipeline latency tail.
SANAS_DRAIN_MS=800
SANAS_SECURE_MEDIA=false

# The engine runs in real time, so wall-clock ~= clip duration. Uploads are
# trimmed to this many seconds so a request can't hang for minutes.
SAN_MAX_CLIP_S=30

# --- Claude (San's conversational brain) ---
# Add your Anthropic API key to route chat through Claude (streamed token-by-token).
# Without it, San uses its deterministic rule-based engine (the UI works either way).
ANTHROPIC_API_KEY=
# Chat model. Sonnet is a good default for low-latency chat; set claude-opus-4-8
# for maximum quality.
SAN_LLM_MODEL=claude-sonnet-4-6
# Adaptive thinking: Claude reasons only when a turn warrants it. Tunables:
#   SAN_LLM_EFFORT   = low | medium | high | max   (depth/cost; default medium)
#   SAN_LLM_THINKING = adaptive | off              (set off for older models that 400)
#   SAN_LLM_MAX_TOKENS = per-response budget (default 4096; thinking shares it)
# SAN_LLM_EFFORT=medium
# SAN_LLM_THINKING=adaptive
# SAN_LLM_MAX_TOKENS=4096

# --- Twilio voice handoff (talk to a human / IVR, with Sanas in the call) ---
# Unset = the feature shows a "not configured" note. Point your Twilio number's
# Voice webhook (and the TwiML App Voice URL) at {PUBLIC_BASE_URL}/api/twilio/voice
PUBLIC_BASE_URL=                 # public https base — your real domain on AWS
                                 # (e.g. https://sani.example.com), or an ngrok URL locally.
                                 # NOTE: also set SITE_ADDRESS (the bare domain, no https://)
                                 # in the shell/root .env so Caddy provisions the cert —
                                 # see DEPLOY_AWS.md.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=                   # your Twilio number (E.164), used as caller ID
TWILIO_HUMAN_NUMBER=             # destination dialed for "talk to a human" (E.164)
TWILIO_API_KEY_SID=              # for the in-browser Voice SDK (Console: API keys)
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=            # TwiML App whose Voice URL = {PUBLIC_BASE_URL}/api/twilio/voice
TWILIO_SANAS_MODEL=AGENTIC_VI_GT_NC   # 8kHz telephony model used on the call audio

# --- "More Information" book-a-demo flow (intake -> email -> Google booking) ---
# The form collects the lead, emails it to DEMO_NOTIFY_EMAIL, sends the contact a
# confirmation with BOOKING_URL, then routes them to that link to pick a time
# (Google Appointment Scheduling creates the invite + emails both parties).
DEMO_NOTIFY_EMAIL=chris.featherstone@sanas.ai      # internal owner who gets each lead
BOOKING_URL=https://calendar.app.google/BzRcDMQAKtHvRJfs8   # your Google booking link
# SMTP for sending the two emails. Unset = the flow still works (lead logged, booking
# link shown) but no email goes out. For Gmail use an App Password (not your login).
SMTP_HOST=                       # e.g. smtp.gmail.com  (or email-smtp.<region>.amazonaws.com)
SMTP_PORT=587                    # 587 STARTTLS (default) or 465 (set SMTP_SSL=true)
SMTP_USER=                       # SMTP username (often the From address)
SMTP_PASS=                       # SMTP password / app password / SES SMTP secret
SMTP_FROM=                       # From address (defaults to SMTP_USER)
SMTP_FROM_NAME=Sani — Sanas
# SMTP_SSL=false
